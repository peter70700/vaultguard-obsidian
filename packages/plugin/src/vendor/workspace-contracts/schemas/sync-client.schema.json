{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vaultguard:workspace-contracts:1:sync-client",
  "title": "Sync client compatibility signal (not authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "capabilities"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    }
  }
}
